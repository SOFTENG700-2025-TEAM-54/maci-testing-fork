# Caliper Benchmarks Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Ethereum Network Configuration
ETHEREUM_RPC_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ETHEREUM_NETWORK_NAME=MACI-Ethereum-Test
ETHEREUM_CHAIN_ID=11155111

# Contract Deployer Configuration
CONTRACT_DEPLOYER_ADDRESS=0xYourContractDeployerAddressHere
CONTRACT_DEPLOYER_PRIVATE_KEY=YourPrivateKeyHere

# Poll Contract Configuration
POLL_CONTRACT_ADDRESS=0xYourPollContractAddressHere

# Caliper Configuration
FROM_ADDRESS_SEED=YourSeedValueHere
TRANSACTION_CONFIRMATION_BLOCKS=1

# Worker Configuration
# Comma-separated list of private keys for workers
WORKER_PRIVATE_KEYS=key1,key2,key3

# MACI Paths (relative to workspace root)
MACI_DOMAINOBJS_PATH=../packages/domainobjs/build/ts/index.js
MACI_SDK_PATH=../packages/sdk/build/ts/index.js

# Benchmark Configuration
BENCHMARK_WORKERS=2
BENCHMARK_TX_NUMBER=20
BENCHMARK_TPS=0.5
BENCHMARK_POLL_ID=0
BENCHMARK_MAX_VOTE_OPTIONS=25
BENCHMARK_MAX_VOTE_WEIGHT=100
BENCHMARK_USERS_PER_WORKER=10

# Coordinator Public Key
COORDINATOR_PUBLIC_KEY=macipk.1ccff4a32d72c267800bbdab8f9a40707fbe31b4db81017516e6e94dcc31a7a9

# Gas Configuration
GAS_ESTIMATE_ENABLED=true
GAS_QUERY_LIMIT=100000
GAS_TRANSFER_LIMIT=70000

# Monitoring (Optional)
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_ENABLED=false
